[Unit]
Description=THE MAIN payment service (CloudPayments widget + webhooks)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=themain
WorkingDirectory=/opt/themain
EnvironmentFile=/opt/themain/.env
# слушаем только localhost — наружу выходит только через nginx+HTTPS (/pay, /cloudpayments/)
ExecStart=/opt/themain/.venv/bin/uvicorn payweb.app:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
